<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Set the base path (change to /folder-name/ if not in root)
  RewriteBase /

  # If the request is for a real file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # For all other requests, redirect to index.html so React Router can take over
  RewriteRule ^ index.html [L]
</IfModule>